# Public Supabase configuration required by authentication and data clients.
# For local development, copy the local API URL and publishable key reported by
# `npx supabase status -o env` into an untracked `.env.local` file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-owned absolute application origin used to construct Auth callback
# destinations. Do not derive this value from a request Host header.
APP_ORIGIN=http://127.0.0.1:3000

# Server-only HMAC secret for the 10-minute recent-password proof. Generate at
# least 32 random bytes (for example: `openssl rand -base64 32`) and configure
# the value only in the server runtime. Never prefix this variable NEXT_PUBLIC_.
AUTH_REAUTH_PROOF_SECRET=

# Server-only HMAC secret for the one-minute account-closure capability. Use a
# different value from AUTH_REAUTH_PROOF_SECRET and provision the matching
# database-side secret separately in Supabase Vault under the name
# `account_closure_capability_v1`. There is intentionally no production
# fallback and no hosted secret is provisioned by this repository.
ACCOUNT_CLOSURE_CAPABILITY_SECRET=

# Do not commit real credentials. Service-role, secret, and direct database
# values are not required by this application and must never use NEXT_PUBLIC_*.
