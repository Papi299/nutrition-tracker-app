{
  "name": "nutrition-tracker-app",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual Hebrew/English manual nutrition tracking MVP.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security:dependencies": "node scripts/check-production-advisories.mjs",
    "security:workflow": "node scripts/check-workflow-security.mjs",
    "security:build-boundary": "node scripts/check-client-secret-boundary.mjs",
    "test:security": "node --test scripts/check-production-advisories.test.mjs && playwright test --config=playwright.unit.config.ts security-headers.spec.ts",
    "test:e2e": "node scripts/run-local-date-e2e.mjs",
    "test:phase11d": "node scripts/run-local-date-e2e.mjs --config=playwright.phase11d.config.ts",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "test:date": "playwright test --config=playwright.unit.config.ts",
    "test:e2e:date": "node scripts/run-local-date-e2e.mjs e2e/date-correctness.spec.ts",
    "test:journey-evidence": "node --test scripts/check-phase-11c-journey-evidence.test.mjs && node scripts/check-phase-11c-journey-evidence.mjs",
    "test:performance-harness": "playwright test --config=playwright.unit.config.ts tests/performance-qualification.spec.ts",
    "test:performance-evidence": "node --experimental-strip-types --test scripts/check-phase-11g2-normative-evidence.test.mjs && node --experimental-strip-types scripts/check-phase-11g2-normative-evidence.mjs",
    "performance:fixture": "node scripts/provision-phase-11g2-fixture.mjs",
    "performance:plans": "node scripts/run-phase-11g2-db-plans.mjs",
    "performance:diagnostic": "node --experimental-strip-types scripts/run-phase-11g2-qualification.mjs",
    "performance:qualify": "node --experimental-strip-types scripts/run-phase-11g2-playwright-qualification.mjs",
    "test:migration-roles": "node scripts/run-hosted-migration-role-tests.mjs",
    "ingestion:foundation:dry-run": "node --experimental-strip-types ingestion/usda/foundation/cli.ts",
    "ingestion:foundation:promote-local": "node --experimental-strip-types ingestion/usda/foundation/promote-local.ts",
    "ingestion:foundation:approval-packet": "node --experimental-strip-types ingestion/usda/foundation/create-production-approval-packet.ts",
    "ingestion:foundation:lifecycle-rehearsal": "node --experimental-strip-types ingestion/usda/foundation/lifecycle/rehearsal.ts",
    "types:ingestion": "node scripts/check-ingestion-types.mjs --write",
    "types:ingestion:check": "node scripts/check-ingestion-types.mjs",
    "supabase:status": "supabase status",
    "supabase:version": "supabase --version"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "next": "16.3.3",
    "next-intl": "^4.9.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "supabase": "2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
